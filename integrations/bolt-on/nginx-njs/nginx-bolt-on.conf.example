# CrawlBouncer — bolt-on integration for stock Nginx (via njs)
#
# This exact config, with the accompanying cb_decide.js, was tested
# against a real nginx 1.24 + njs (Ubuntu's libnginx-mod-http-js
# 0.8.2) instance, a real running CrawlBouncer backend, and a mock origin
# server — allow and block both
# verified working. Two earlier approaches were tried and rejected
# after testing found they didn't actually work — see the comment at
# the top of cb_decide.js for what was tried and why it failed.
#
# Prerequisite: nginx must have ngx_http_js_module loaded.
#   Debian/Ubuntu: apt install libnginx-mod-http-js
#   (NOT "nginx-module-njs" — that package name doesn't exist on
#   current Debian/Ubuntu; found by testing, not assumed.)
#   Other distros / self-compiled nginx: https://nginx.org/en/docs/njs/install.html
#
# Load once, near the top of nginx.conf (outside any server block):
#   load_module modules/ngx_http_js_module.so;

http {
    js_import cb_decide from cb_decide.js;

    # The edge key shown ONCE when you added this domain as bolt-on
    # in the CrawlBouncer dashboard, and the API base (omit cb_api_base to
    # use the default).
    js_var $cb_edge_key "cb_edge_YOUR_KEY_HERE";
    js_var $cb_api_base "http://127.0.0.1:8000";

    # ngx.fetch() needs a resolver to look up the CrawlBouncer API host.
    resolver 8.8.8.8;

    server {
        listen 443 ssl http2;
        server_name yourblog.com;

        # ... your existing ssl_certificate / other directives unchanged ...

        location / {
            # js_content must produce the whole response itself — it
            # can't "fall through" to another directive the way
            # auth_request-style checks can. For "allow", the handler
            # itself does an internal redirect to @cb_origin below.
            js_content cb_decide.decide;
        }

        location @cb_origin {
            internal;
            proxy_pass http://127.0.0.1:8080;   # <- your actual origin app
        }
    }
}
