# ─────────────────────────────────────────────────────────────────
# CrawlBouncer configuration.  Copy to .env:   cp .env.example .env
# NEVER commit .env to Git (it is in .gitignore).
# ─────────────────────────────────────────────────────────────────

# development | production.  Use "production" on a real server.
ENV=development
PORT=8000

# REQUIRED for real use. Generate one with:  openssl rand -hex 32
# (If left empty a random one is made at startup, and everyone gets logged out on every restart.)
JWT_SECRET=

# Needed for two-factor auth (optional). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=

# Where SQLite stores its data (Docker sets this for you)
# SQLITE_PATH=./crawlbouncer.db

# ── Accounts ─────────────────────────────────────────────────────
# The first account you create is the admin. After that, signups are closed
# unless you set this to true (or you invite people from Settings → Team).
ALLOW_SIGNUPS=false

# ── Public URLs ──────────────────────────────────────────────────
# Used in email links
APP_BASE_URL=http://localhost:8000
# Hostnames that serve the dashboard itself (comma-separated), NOT protected sites
PLATFORM_HOSTS=localhost,127.0.0.1
# Production only: extra browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=
# Hostname protected sites point their CNAME at
PROXY_BASE=proxy.example.com

# ── Optional: email (plain SMTP, any provider) ───────────────────
# Leave SMTP_HOST empty and emails are just printed in the server log,
# and new accounts are active immediately (fine for a private box).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
EMAIL_FROM=crawlbouncer@example.com

# ── Optional: alerts ─────────────────────────────────────────────
ALERT_EMAIL=
SLACK_WEBHOOK_URL=

# ── Optional: extra features ─────────────────────────────────────
# Serve a clean text version of pages to allowed AI crawlers
MIRROR_ENABLED=false
# IP reputation lookups (free tier at abuseipdb.com). Empty = skipped.
ABUSEIPDB_API_KEY=

# ── Tuning ───────────────────────────────────────────────────────
DATA_RETENTION_DAYS=90
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW=60
BOT_RATE_LIMIT=20
# Reverse proxies whose X-Forwarded-For header you trust, e.g. 127.0.0.1/32
TRUSTED_PROXY_CIDRS=
